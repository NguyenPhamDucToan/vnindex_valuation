# Copy this file to secrets.toml and fill in your values.
# secrets.toml is gitignored — never commit it.
#
# On Streamlit Community Cloud: paste these in the app's
#   Settings → Secrets  (one key=value per line, TOML format)

# Supabase Postgres connection string (from Project Overview → Get connected → Direct)
DATABASE_URL = "postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# FireAnt REST API key (free tier at fireant.vn — optional, enables analyst recommendations)
FIREANT_API_KEY = "your_fireant_api_key_here"
